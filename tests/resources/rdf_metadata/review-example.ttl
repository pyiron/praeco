@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .

<https://example.org/dataset> a dcat:Dataset ;
    dct:title "Tensile measurements", "Tensile test data" ;
    dct:creator <https://example.org/people/jane>, <https://example.org/organizations/lab> ;
    dct:issued "2020-01-01", "2021-01-01" ;
    dct:created "2019-12-01" ;
    dct:license "CC-BY-4.0" ;
    dcat:keyword "steel", "tensile testing" .

<https://example.org/people/jane> a foaf:Person ; foaf:name "Jane Doe" .
<https://example.org/organizations/lab> a schema:Organization .
